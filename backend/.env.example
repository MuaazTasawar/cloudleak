# AWS credentials — TODO: put your own IAM user access key + secret here
# (use an IAM user scoped to Cost Explorer read, CloudWatch read, EC2 describe/stop/terminate — not root)
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=eu-north-1

# DynamoDB table names — must match infra/dynamodb.tf resource names
DYNAMODB_TABLE_SPEND=cloudleak-spend-baseline
DYNAMODB_TABLE_ANOMALIES=cloudleak-anomalies
DYNAMODB_TABLE_RESOURCES=cloudleak-flagged-resources

# Slack — TODO: create an Incoming Webhook in your Slack workspace and paste the URL here
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# Anomaly detection tuning
ANOMALY_ZSCORE_THRESHOLD=2.5
COST_BASELINE_DAYS=7

# Idle resource heuristics
IDLE_CPU_THRESHOLD_PERCENT=5.0
IDLE_NETWORK_THRESHOLD_BYTES=1000000
IDLE_HOURS_THRESHOLD=6

# CORS — comma separated origins allowed to call this API
CORS_ORIGINS=http://localhost:3000